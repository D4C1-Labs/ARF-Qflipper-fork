qFlipper.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile qFlipper.pro -spec win32-g++

qmake_all: sub-3rdparty-qmake_all sub-application-qmake_all sub-backend-qmake_all sub-dfu-qmake_all sub-plugins-qmake_all sub-cli-qmake_all FORCE

make_first: sub-3rdparty-make_first sub-application-make_first sub-backend-make_first sub-dfu-make_first sub-plugins-make_first sub-cli-make_first  FORCE
all: sub-3rdparty-all sub-application-all sub-backend-all sub-dfu-all sub-plugins-all sub-cli-all  FORCE
clean: sub-3rdparty-clean sub-application-clean sub-backend-clean sub-dfu-clean sub-plugins-clean sub-cli-clean  FORCE
distclean: sub-3rdparty-distclean sub-application-distclean sub-backend-distclean sub-dfu-distclean sub-plugins-distclean sub-cli-distclean  FORCE
	-$(DEL_FILE) Makefile
	-$(DEL_FILE) .qmake.stash
install_subtargets: sub-3rdparty-install_subtargets sub-application-install_subtargets sub-backend-install_subtargets sub-dfu-install_subtargets sub-plugins-install_subtargets sub-cli-install_subtargets FORCE
uninstall_subtargets: sub-3rdparty-uninstall_subtargets sub-application-uninstall_subtargets sub-backend-uninstall_subtargets sub-dfu-uninstall_subtargets sub-plugins-uninstall_subtargets sub-cli-uninstall_subtargets FORCE

sub-3rdparty-debug:
	@if not exist 3rdparty\ mkdir 3rdparty\ & if not exist 3rdparty\ exit 1
	cd 3rdparty\ && ( if not exist Makefile $(QMAKE) -o Makefile C:\Users\Amaury\Desktop\qFlipper-ARF\3rdparty\3rdparty.pro -spec win32-g++ ) && $(MAKE) -f Makefile debug
sub-application-debug: sub-backend-debug
	@if not exist application\ mkdir application\ & if not exist application\ exit 1
	cd application\ && ( if not exist Makefile $(QMAKE) -o Makefile C:\Users\Amaury\Desktop\qFlipper-ARF\application\application.pro -spec win32-g++ ) && $(MAKE) -f Makefile debug
sub-backend-debug: sub-dfu-debug sub-plugins-debug
	@if not exist backend\ mkdir backend\ & if not exist backend\ exit 1
	cd backend\ && ( if not exist Makefile $(QMAKE) -o Makefile C:\Users\Amaury\Desktop\qFlipper-ARF\backend\backend.pro -spec win32-g++ ) && $(MAKE) -f Makefile debug
sub-dfu-debug:
	@if not exist dfu\ mkdir dfu\ & if not exist dfu\ exit 1
	cd dfu\ && ( if not exist Makefile $(QMAKE) -o Makefile C:\Users\Amaury\Desktop\qFlipper-ARF\dfu\dfu.pro -spec win32-g++ ) && $(MAKE) -f Makefile debug
sub-plugins-debug: sub-3rdparty-debug
	@if not exist plugins\ mkdir plugins\ & if not exist plugins\ exit 1
	cd plugins\ && ( if not exist Makefile $(QMAKE) -o Makefile C:\Users\Amaury\Desktop\qFlipper-ARF\plugins\plugins.pro -spec win32-g++ ) && $(MAKE) -f Makefile debug
sub-cli-debug: sub-backend-debug
	@if not exist cli\ mkdir cli\ & if not exist cli\ exit 1
	cd cli\ && ( if not exist Makefile $(QMAKE) -o Makefile C:\Users\Amaury\Desktop\qFlipper-ARF\cli\cli.pro -spec win32-g++ ) && $(MAKE) -f Makefile debug
debug: sub-3rdparty-debug sub-application-debug sub-backend-debug sub-dfu-debug sub-plugins-debug sub-cli-debug

sub-3rdparty-release:
	@if not exist 3rdparty\ mkdir 3rdparty\ & if not exist 3rdparty\ exit 1
	cd 3rdparty\ && ( if not exist Makefile $(QMAKE) -o Makefile C:\Users\Amaury\Desktop\qFlipper-ARF\3rdparty\3rdparty.pro -spec win32-g++ ) && $(MAKE) -f Makefile release
sub-application-release: sub-backend-release
	@if not exist application\ mkdir application\ & if not exist application\ exit 1
	cd application\ && ( if not exist Makefile $(QMAKE) -o Makefile C:\Users\Amaury\Desktop\qFlipper-ARF\application\application.pro -spec win32-g++ ) && $(MAKE) -f Makefile release
sub-backend-release: sub-dfu-release sub-plugins-release
	@if not exist backend\ mkdir backend\ & if not exist backend\ exit 1
	cd backend\ && ( if not exist Makefile $(QMAKE) -o Makefile C:\Users\Amaury\Desktop\qFlipper-ARF\backend\backend.pro -spec win32-g++ ) && $(MAKE) -f Makefile release
